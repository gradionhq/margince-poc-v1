{
  // The COMPOSED frontend lane — the TypeScript mirror of
  // GOWORK=build/composition/go.work. Same sources, same strictness, one
  // difference: "@composition/extensions" resolves the generated registry under
  // build/composition/frontend/ instead of the committed empty-tree stub.
  //
  // It is a separate project rather than a committed regeneration of the
  // vanilla file on purpose. A single committed-from-composed file cannot
  // serve both worlds: it would make the vanilla tree's output depend on which
  // units happened to be enabled when someone last ran `make gen`, and the
  // empty-tree byte-identity that stubMatchesVanilla and the UAT's final
  // acceptance step prove would be gone.
  //
  // Run it through `make fe-typecheck-composed`, which fails loudly when
  // build/composition/frontend/ is absent rather than falling back to the
  // vanilla alias and typechecking a lane nobody composed.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    // Not a member of the solution build (tsconfig.json references only the
    // app + node projects), so it needs neither project-reference metadata nor
    // a build-info file shared with the vanilla lane.
    "composite": false,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.composed.tsbuildinfo",
    "paths": {
      "@composition/extensions": [
        "../build/composition/frontend/extensions.gen"
      ],
      // The MERGED contract's types, so the typed client (src/api/client.ts) is
      // parameterised by the document THIS installation actually serves — a
      // unit screen can call its own /v1/ext/<unit>/… route with the same
      // `api.GET` every core screen uses, no wrapper and no cast.
      //
      // A SECOND root, not build/composition/frontend/: gen-composition's
      // -verify requires that tree to hold exactly the files it generated, and
      // openapi-typescript is a Node tool the Go generator cannot run. Writing
      // here spends nothing — see .gitignore and the Makefile target.
      "@composition/schema": ["../build/composition-frontend/schema"],
      // The unit screens themselves. This is the lane that can compile them:
      // each one calls its unit's own /ext/<unit>/… routes through the shared
      // `api` client, and those paths are in the merged contract above and
      // nowhere else. So a screen for a unit whose fragment did not merge does
      // not typecheck HERE — the route half of the ordering constraint,
      // enforced at compile time (the RBAC-object half is not; see
      // src/app/capability.ts).
      "@composition/screens": ["./src/screens/ext/index"]
    }
  },
  // The app lane excludes src/screens/ext/ because it cannot express those
  // calls. This lane can, and must: an excluded screen would be a screen the
  // composed build ships and no gate ever typechecked.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
