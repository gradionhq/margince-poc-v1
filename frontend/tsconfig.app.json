{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    // The composition alias — the TypeScript mirror of GOWORK. This project is
    // the VANILLA lane and resolves the committed empty-tree registry;
    // tsconfig.composed.json repoints the same specifier at
    // build/composition/frontend/. vite.config.ts carries the runtime half of
    // the same selection, keyed off MARGINCE_COMPOSITION_FRONTEND.
    //
    // Exact specifiers, not a "@composition/*" wildcard: a wildcard would also
    // have to agree with Vite's own alias about how a bare name maps onto a
    // ".gen.ts" file, and two spellings of one rule is how they drift.
    //
    // THREE artifacts, because a unit surface needs all three. "extensions" is
    // the registry (a runtime value). "schema" is the CONTRACT types the typed
    // client is parameterised by: in this lane it is the committed
    // src/api/schema.d.ts, so `api.GET("/ext/…")` is correctly a type error —
    // the vanilla installation does not serve that route. The composed lane
    // points it at the types generated from the MERGED contract, where it is
    // not. "screens" is the unit SCREENS an installation mounts: in this lane
    // an empty registry, in the composed lane src/screens/ext/. Those screens
    // call their unit's routes, which exist in `paths` only where the
    // installation serves them — so they are compiled by the composed lane
    // alone, and src/screens/ext/ is excluded below rather than failing every
    // vanilla build on a call it correctly cannot express.
    "paths": {
      "@composition/extensions": ["./src/composition/extensions.gen"],
      "@composition/schema": ["./src/api/schema"],
      "@composition/screens": ["./src/composition/extscreens"]
    }
  },
  "include": ["src"],
  // src/screens/ext/ is NOT dead code excluded for convenience: it is the
  // composed lane's program, typechecked by tsconfig.composed.json against the
  // merged contract, and reached at runtime only through the alias above. An
  // `exclude` is enough precisely because nothing in this lane imports it —
  // tsc follows imports past an exclusion, so a stray import here would put it
  // straight back and fail, which is the outcome we want if one ever appears.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/screens/ext/**"]
}
