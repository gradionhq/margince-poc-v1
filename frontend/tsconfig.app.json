{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    // The composition alias — the TypeScript mirror of GOWORK. This project is
    // the VANILLA lane and resolves the committed empty-tree registry;
    // tsconfig.composed.json repoints the same specifier at
    // build/composition/frontend/. vite.config.ts carries the runtime half of
    // the same selection, keyed off MARGINCE_COMPOSITION_FRONTEND.
    //
    // One exact specifier, not a "@composition/*" wildcard: there is exactly
    // one composed frontend artifact today, and a wildcard would also have to
    // agree with Vite's own alias about how a bare name maps onto a
    // ".gen.ts" file — two spellings of one rule is how they drift.
    "paths": {
      "@composition/extensions": ["./src/composition/extensions.gen"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
