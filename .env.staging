# Margince — D13 STAGING environment (managed by Vault).
#
# This committed file is the human-readable REFERENCE for what lives in Vault.
# The real values (VAULT_MANAGED below) are stored in the D13 Vault UI; the
# pipeline materializes the actual `./.env` from Vault before the Docker build,
# and the api/worker entrypoints source it. Do NOT put real secrets here.
#
# The var table of record is docs/reference/configuration.md.

# ── Database (roles created once by scripts/d13/db-bootstrap.sql) ─────────────
# App role the api + worker serve under (RLS binds it — never a superuser).
#   postgres://margince_app:<APP_PW>@database:5432/margince?sslmode=disable
MARGINCE_DSN=VAULT_MANAGED
# Owner role the api entrypoint runs migrations + the custom-fields DDL pool as.
#   postgres://margince_owner:<OWNER_PW>@database:5432/margince?sslmode=disable
MARGINCE_OWNER_DSN=VAULT_MANAGED

# ── Redis (event bus / outbox relay) — the D13 public service "cache" ─────────
MARGINCE_REDIS=cache:6379

# ── Canonical external base URL (buyer-facing links, marketing mail) ──────────
MARGINCE_PUBLIC_BASE_URL=https://margince.staging.gradion.com

# ── Logging ──────────────────────────────────────────────────────────────────
MARGINCE_LOG_LEVEL=info
MARGINCE_LOG_FORMAT=json

# ── First-boot bootstrap admin password ──────────────────────────────────────
# Written 0600 to secrets/admin-password by the api entrypoint; consumed only on
# the first boot against an empty DB (config/margince.staging.yaml references it).
# Must be >= 12 chars. Reset later with `migrate reset-password` if needed.
MARGINCE_ADMIN_PASSWORD=VAULT_MANAGED

# ── AI runtime (config/ai-routing.yaml binds gemini across the tiers) ─────────
# BYOK key read from the environment at boot (ADR-0020); a missing key fails the
# bound AI lanes closed while core CRUD keeps working.
GEMINI_API_KEY=VAULT_MANAGED

# ── Optional, off by default (uncomment + add to Vault to enable) ─────────────
# Connector-credential vault (Gmail/M365/IMAP sealing). base64 of 32 bytes.
# MARGINCE_KEYVAULT_ROOT_KEY=VAULT_MANAGED
# Outbound-webhook signing-secret seal. base64 of 32 bytes.
# MARGINCE_WEBHOOK_KEY=VAULT_MANAGED
#
# NOTE: MARGINCE_ENV is deliberately UNSET — `dev` enables dev-only trust
# switches and must never be set in a deployed environment.
