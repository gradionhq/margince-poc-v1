# Keep the image build context lean. The Go images need the whole repo (backend,
# backend/tools, cli/craft, extensions/*, go.work, the composition/ stub) so the
# gen-composition step can materialize build/composition/ — do NOT exclude those.
# The web image needs frontend/ + backend/api/*.yaml. Only regenerable machine
# debris is excluded here.
.git
**/node_modules
frontend/dist
frontend/test-results
frontend/playwright-report
frontend/storybook-static
# build/composition/ is regenerated inside the image; a stale local copy must
# never ride in.
build/composition
.tmp
*.log
# Local per-developer secrets never belong in an image.
.env
.env.local
